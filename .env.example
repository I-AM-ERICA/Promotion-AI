# Never commit real API keys. Copy this file to .env for live mode.
CLOVA_STUDIO_API_KEY=
# Must match the Spring backend AI_INTERNAL_KEY.
AI_INTERNAL_KEY=local-internal-key
POSTER_PUBLIC_BASE_URL=http://127.0.0.1:8081
POSTER_TIMEOUT_SECONDS=70
# Runtime defaults to %LOCALAPPDATA%/Promotion-AI/data (Linux: ~/.local/share/Promotion-AI/data).
# POSTER_DATA_DIR=
# POSTER_FONT_PATH=C:/Windows/Fonts/malgun.ttf
# POSTER_BOLD_FONT_PATH=C:/Windows/Fonts/malgunbd.ttf
